{
  "name": "@fork-lens/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "vp test",
    "request": "hono request src/index.ts",
    "db:migrate:local": "cf d1 migrations apply 11111111-1111-4111-8111-111111111111 --local --persist-to .cloudflare/state --dir ../../packages/db/drizzle",
    "db:migrate:remote": "cf d1 migrations apply --dir ../../packages/db/drizzle"
  },
  "dependencies": {
    "@fork-lens/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@hono/cli": "0.1.11",
    "cf": "1.0.0-beta.32",
    "miniflare": "5.20261113.0-beta",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  }
}
